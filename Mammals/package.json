{
  "name": "mammals-sunburst",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zoomable sunburst of the mammal taxonomy",
  "scripts": {
    "data": "node scripts/build-taxonomy.mjs --include-extinct",
    "images": "node scripts/fetch-images.mjs",
    "names": "node scripts/fetch-names.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "npx --yes serve . -l 5173"
  }
}
